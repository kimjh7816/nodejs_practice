PORT=3000

# MySQL (Prisma 접속 정보)
DATABASE_URL="mysql://root:password@localhost:3306/node_study"

# 소셜 로그인 콜백 URL의 앞부분. 각 제공자 콘솔에 등록한 주소와 같아야 한다.
BASE_URL="http://localhost:3000"

# 세션 쿠키 서명 키. 아무 긴 문자열이면 된다.
EXPRESS_SESSION_SECRET=""

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급
# 승인된 리디렉션 URI: http://localhost:3000/oauth2/callback/google
PASSPORT_GOOGLE_CLIENT_ID=""
PASSPORT_GOOGLE_CLIENT_SECRET=""

# 네이버 개발자센터(developers.naver.com) > 애플리케이션 등록에서 발급
# Callback URL: http://localhost:3000/oauth2/callback/naver
PASSPORT_NAVER_CLIENT_ID=""
PASSPORT_NAVER_CLIENT_SECRET=""
