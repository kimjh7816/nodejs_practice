generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model food_categories {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String                  @unique(map: "uk_food_categories_name") @db.VarChar(30)
  sort_order            Int                     @default(0) @db.SmallInt
  is_active             Boolean                 @default(true)
  stores                stores[]
  user_food_preferences user_food_preferences[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model missions {
  id               BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  store_id         BigInt                  @db.UnsignedBigInt
  region_id        BigInt                  @db.UnsignedBigInt
  title            String                  @db.VarChar(100)
  description      String?                 @db.VarChar(500)
  condition_type   missions_condition_type @default(MIN_ORDER_AMOUNT)
  min_order_amount Int                     @default(0) @db.UnsignedInt
  reward_type      missions_reward_type
  reward_point     Int?                    @db.UnsignedInt
  reward_rate      Decimal?                @db.Decimal(5, 2)
  challenge_days   Int                     @default(7) @db.UnsignedSmallInt
  total_quota      Int?                    @db.UnsignedInt
  issued_count     Int                     @default(0) @db.UnsignedInt
  opened_at        DateTime                @db.DateTime(0)
  closed_at        DateTime?               @db.DateTime(0)
  status           missions_status         @default(DRAFT)
  created_at       DateTime                @default(now()) @db.DateTime(0)
  updated_at       DateTime                @default(now()) @db.DateTime(0)
  regions          regions                 @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_missions_region")
  stores           stores                  @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_missions_store")
  user_missions    user_missions[]

  @@index([region_id, status, closed_at], map: "idx_missions_region_status")
  @@index([store_id, status], map: "idx_missions_store")
}

model phone_verifications {
  id            BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  phone         String                      @db.VarChar(20)
  code          String                      @db.Char(6)
  purpose       phone_verifications_purpose @default(SIGNUP)
  attempt_count Int                         @default(0) @db.UnsignedTinyInt
  expires_at    DateTime                    @db.DateTime(0)
  verified_at   DateTime?                   @db.DateTime(0)
  created_at    DateTime                    @default(now()) @db.DateTime(0)

  @@index([phone, created_at], map: "idx_phone_verifications")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model point_transactions {
  id            BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt                         @db.UnsignedBigInt
  amount        Int
  balance_after Int                            @db.UnsignedInt
  type          point_transactions_type
  source_type   point_transactions_source_type
  source_id     BigInt?                        @db.UnsignedBigInt
  description   String?                        @db.VarChar(255)
  created_at    DateTime                       @default(now()) @db.DateTime(0)
  users         users                          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pt_user")

  @@unique([source_type, source_id, type], map: "uk_pt_source")
  @@index([user_id, created_at], map: "idx_pt_user")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model regions {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  code                 String                 @unique(map: "uk_regions_code") @db.Char(10)
  sido                 String                 @db.VarChar(20)
  sigungu              String                 @db.VarChar(30)
  dong                 String                 @db.VarChar(30)
  display_name         String                 @db.VarChar(50)
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.DateTime(0)
  missions             missions[]
  stores               stores[]
  user_missions        user_missions[]
  user_region_progress user_region_progress[]
  users                users[]

  @@index([is_active, display_name], map: "idx_regions_active")
}

model review_images {
  id         BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  review_id  BigInt  @db.UnsignedBigInt
  image_url  String  @db.VarChar(512)
  sort_order Int     @default(0) @db.UnsignedTinyInt
  reviews    reviews @relation(fields: [review_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ri_review")

  @@index([review_id, sort_order], map: "idx_review_images")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  user_id         BigInt          @db.UnsignedBigInt
  store_id        BigInt          @db.UnsignedBigInt
  user_mission_id BigInt?         @unique(map: "uk_reviews_user_mission") @db.UnsignedBigInt
  rating          Int             @db.UnsignedTinyInt
  content         String          @db.VarChar(1000)
  created_at      DateTime        @default(now()) @db.DateTime(0)
  updated_at      DateTime        @default(now()) @db.DateTime(0)
  deleted_at      DateTime?       @db.DateTime(0)
  review_images   review_images[]
  user_missions   user_missions?  @relation(fields: [user_mission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reviews_mission")
  stores          stores          @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reviews_store")
  users           users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reviews_user")

  @@index([store_id, created_at], map: "idx_reviews_store")
  @@index([user_id, created_at], map: "idx_reviews_user")
}

model stores {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  region_id       BigInt          @db.UnsignedBigInt
  category_id     BigInt          @db.UnsignedBigInt
  name            String          @db.VarChar(60)
  phone           String?         @db.VarChar(20)
  zipcode         String?         @db.Char(5)
  address1        String          @db.VarChar(200)
  address2        String?         @db.VarChar(100)
  thumbnail_url   String?         @db.VarChar(512)
  open_time       DateTime?       @db.Time(0)
  close_time      DateTime?       @db.Time(0)
  rating_avg      Decimal         @default(0.0) @db.Decimal(2, 1)
  review_count    Int             @default(0) @db.UnsignedInt
  status          stores_status   @default(ACTIVE)
  created_at      DateTime        @default(now()) @db.DateTime(0)
  updated_at      DateTime        @default(now()) @db.DateTime(0)
  missions        missions[]
  reviews         reviews[]
  food_categories food_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stores_category")
  regions         regions         @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_stores_region")
  user_missions   user_missions[]

  @@index([category_id], map: "fk_stores_category")
  @@index([region_id, status], map: "idx_stores_region_status")
}

model terms {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  code                 String                 @db.VarChar(40)
  title                String                 @db.VarChar(100)
  version              String                 @db.VarChar(20)
  is_required          Boolean
  content_url          String?                @db.VarChar(512)
  effective_from       DateTime               @db.Date
  is_active            Boolean                @default(true)
  user_term_agreements user_term_agreements[]

  @@unique([code, version], map: "uk_terms_code_version")
}

model user_food_preferences {
  user_id         BigInt          @db.UnsignedBigInt
  category_id     BigInt          @db.UnsignedBigInt
  created_at      DateTime        @default(now()) @db.DateTime(0)
  food_categories food_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ufp_category")
  users           users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ufp_user")

  @@id([user_id, category_id])
  @@index([category_id], map: "fk_ufp_category")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model user_missions {
  id                BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id           BigInt                    @db.UnsignedBigInt
  mission_id        BigInt                    @db.UnsignedBigInt
  store_id          BigInt                    @db.UnsignedBigInt
  region_id         BigInt                    @db.UnsignedBigInt
  status            user_missions_status      @default(IN_PROGRESS)
  verification_code String?                   @unique(map: "uk_um_code") @db.Char(9)
  reward_type       user_missions_reward_type
  reward_point      Int?                      @db.UnsignedInt
  reward_rate       Decimal?                  @db.Decimal(5, 2)
  paid_amount       Int?                      @db.UnsignedInt
  earned_point      Int?                      @db.UnsignedInt
  started_at        DateTime                  @default(now()) @db.DateTime(0)
  expires_at        DateTime                  @db.DateTime(0)
  requested_at      DateTime?                 @db.DateTime(0)
  completed_at      DateTime?                 @db.DateTime(0)
  canceled_at       DateTime?                 @db.DateTime(0)
  created_at        DateTime                  @default(now()) @db.DateTime(0)
  updated_at        DateTime                  @default(now()) @db.DateTime(0)
  active_flag       Int?                      @db.UnsignedTinyInt
  reviews           reviews?
  missions          missions                  @relation(fields: [mission_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_um_mission")
  regions           regions                   @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_um_region")
  stores            stores                    @relation(fields: [store_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_um_store")
  users             users                     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_um_user")

  @@unique([user_id, mission_id, active_flag], map: "uk_um_active")
  @@index([mission_id], map: "fk_um_mission")
  @@index([region_id], map: "fk_um_region")
  @@index([store_id], map: "fk_um_store")
  @@index([status, expires_at], map: "idx_um_expire_batch")
  @@index([user_id, region_id, status], map: "idx_um_user_region_status")
  @@index([user_id, status, created_at], map: "idx_um_user_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_region_progress {
  user_id       BigInt    @db.UnsignedBigInt
  region_id     BigInt    @db.UnsignedBigInt
  success_count Int       @default(0) @db.UnsignedInt
  bonus_count   Int       @default(0) @db.UnsignedInt
  last_bonus_at DateTime? @db.DateTime(0)
  updated_at    DateTime  @default(now()) @db.DateTime(0)
  regions       regions   @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_urp_region")
  users         users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_urp_user")

  @@id([user_id, region_id])
  @@index([region_id], map: "fk_urp_region")
}

model user_social_accounts {
  id               BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  user_id          BigInt                        @db.UnsignedBigInt
  provider         user_social_accounts_provider
  provider_user_id String
  connected_at     DateTime                      @default(now()) @db.DateTime(0)
  users            users                         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_social_user")

  @@unique([provider, provider_user_id], map: "uk_social_provider_uid")
  @@unique([user_id, provider], map: "uk_social_user_provider")
}

model user_term_agreements {
  user_id   BigInt   @db.UnsignedBigInt
  term_id   BigInt   @db.UnsignedBigInt
  is_agreed Boolean  @default(true)
  agreed_at DateTime @default(now()) @db.DateTime(0)
  terms     terms    @relation(fields: [term_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_uta_term")
  users     users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_uta_user")

  @@id([user_id, term_id])
  @@index([term_id], map: "fk_uta_term")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  region_id             BigInt?                 @db.UnsignedBigInt
  email                 String                  @unique(map: "uk_users_email") @db.VarChar(255)
  password_hash         String?                 @db.VarChar(255)
  name                  String                  @db.VarChar(50)
  nickname              String?                 @unique(map: "uk_users_nickname") @db.VarChar(20)
  gender                users_gender            @default(NONE)
  birth_date            DateTime?               @db.Date
  phone                 String?                 @db.VarChar(20)
  phone_verified_at     DateTime?               @db.DateTime(0)
  zipcode               String?                 @db.Char(5)
  address1              String?                 @db.VarChar(200)
  address2              String?                 @db.VarChar(100)
  point_balance         Int                     @default(0) @db.UnsignedInt
  profile_image_url     String?                 @db.VarChar(512)
  status                users_status            @default(ACTIVE)
  last_login_at         DateTime?               @db.DateTime(0)
  created_at            DateTime                @default(now()) @db.DateTime(0)
  updated_at            DateTime                @default(now()) @db.DateTime(0)
  withdrawn_at          DateTime?               @db.DateTime(0)
  point_transactions    point_transactions[]
  reviews               reviews[]
  user_food_preferences user_food_preferences[]
  user_missions         user_missions[]
  user_region_progress  user_region_progress[]
  user_social_accounts  user_social_accounts[]
  user_term_agreements  user_term_agreements[]
  regions               regions?                @relation(fields: [region_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_users_region")

  @@index([region_id], map: "idx_users_region")
}

enum user_social_accounts_provider {
  KAKAO
  NAVER
  GOOGLE
  APPLE
}

enum phone_verifications_purpose {
  SIGNUP
  CHANGE_PHONE
}

enum point_transactions_type {
  MISSION_REWARD
  REGION_BONUS
  ADMIN_ADJUST
}

enum missions_condition_type {
  MIN_ORDER_AMOUNT
}

enum point_transactions_source_type {
  USER_MISSION
  REGION_PROGRESS
  ADMIN
}

enum user_missions_status {
  IN_PROGRESS
  REQUESTED
  SUCCESS
  CANCELED
  EXPIRED
}

enum users_gender {
  MALE
  FEMALE
  NONE
}

enum missions_reward_type {
  POINT
  RATE
}

enum user_missions_reward_type {
  POINT
  RATE
}

enum stores_status {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum missions_status {
  DRAFT
  OPEN
  CLOSED
}

enum users_status {
  ACTIVE
  DORMANT
  WITHDRAWN
}
